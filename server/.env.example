# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Where the React site runs (used for CORS, Paystack callback and links inside emails)
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Local:  mongodb://127.0.0.1:27017/ngfw-tickets
# Atlas:  mongodb+srv://USER:PASS@cluster.mongodb.net/ngfw-tickets
MONGO_URI=mongodb://127.0.0.1:27017/ngfw-tickets

# ---------- Secrets (use long random strings; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----------
JWT_SECRET=change-me-to-a-long-random-string
# Signs every ticket QR code. NEVER change this after tickets are sold, or old QR codes stop verifying.
TICKET_SECRET=change-me-to-another-long-random-string

# ---------- Paystack ----------
# Test key (sk_test_...) while building, live key (sk_live_...) at launch
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Email (Nodemailer) ----------
# Free option: Gmail + App Password (Google Account > Security > 2-Step Verification > App passwords)
# Leave SMTP_USER empty to run in "dev mode": emails are not sent, the ticket link is printed in the terminal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nigeria Gala Fashion Week <yourgmail@gmail.com>"

# ---------- First-run accounts (created automatically if they don't exist) ----------
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword1
HOST_NAME=NGFW Host
HOST_EMAIL=host@example.com
HOST_PASSWORD=ChangeThisHostPassword1

# Platform share of NET revenue (after Paystack fees), in percent. Admin can change it in the dashboard.
PLATFORM_SHARE_PERCENT=10
